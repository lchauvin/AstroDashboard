# Copy to .env (next to this file) and fill in. The engine reads it at startup;
# a variable already set in the real environment wins. .env is git-ignored.

# Astrospheric Professional API key (astrospheric.com → My Profile), for the Planning forecast.
ASTROSPHERIC_API_KEY=

# Live → Guiding AI advisor: only the key for the provider in Settings → Live · Ingest → Model.
# A local Ollama (ollama/...) needs no key, and neither do ":cloud" models run through it.
# OLLAMA_API_KEY=        # ollama_cloud/...
# OPENROUTER_API_KEY=    # openrouter/...
# OPENAI_API_KEY=        # openai/...
# ANTHROPIC_API_KEY=     # anthropic/...

# Telescopius API key (telescopius.com → account settings → API Keys; patrons/sponsors), for target data.
TELESCOPIUS_API_KEY=
