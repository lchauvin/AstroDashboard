# Copy to .env (next to this file) and fill in. The engine reads it at startup;
# a variable already set in the real environment wins. .env is git-ignored.

# Astrospheric Professional API key (astrospheric.com → My Profile), for the Planning forecast.
ASTROSPHERIC_API_KEY=

# Only if AstroController runs with a token (Live).
# ASTROCONTROLLER_TOKEN=
